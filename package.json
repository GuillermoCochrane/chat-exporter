{
  "name": "chat-exporter",
  "version": "1.3.0",
  "description": "Convert conversations exported from ChatGPT into clean, reusable Markdown documents.",
  "keywords": [
    "chatgpt",
    "markdown",
    "export",
    "conversation",
    "ai",
    "cli",
    "json"
  ],
  "author": "Guillermo Cochrane",
  "license": "MIT",
  "type": "module",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuillermoCochrane/chat-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/GuillermoCochrane/chat-exporter/issues"
  },
  "homepage": "https://github.com/GuillermoCochrane/chat-exporter",
  "scripts": {
    "start": "node src/main.js",
    "manualtest": "bash ./run-manual-tests.sh",
    "test": "node test/all.test.js",
    "test:formatter": "node test/formatter.test.js",
    "test:validator": "node test/validator.test.js",
    "test:parser": "node test/parser.test.js",
    "test:filter": "node test/filter.test.js",
    "test:normalizer": "node test/normalizer.test.js",
    "test:markdown": "node test/markdown.test.js",
    "test:markdown:compact": "node test/markdown-compact.test.js",
    "test:loader": "node test/jsonFileSource.test.js",
    "test:writer": "node test/writer.test.js",
    "build:extension": "node assets/scripts/buildExtension.js",
    "build:extension:zip": "node assets/scripts/buildExtensionZip.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}