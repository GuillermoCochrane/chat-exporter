{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "description": "Captura conversaciones de ChatGPT.",
  "version": "1.1.0",

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}