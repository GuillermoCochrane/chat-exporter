{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "description": "Captura conversaciones de ChatGPT.",
  "version": "1.1.0",

  "permissions": [
    "downloads"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "AI Chat Exporter"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}